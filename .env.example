# Conexão com o banco de dados PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/estudodiario?sslmode=disable

# Segredo para assinatura de tokens JWT (mínimo de 32 caracteres)
JWT_SECRET=chave_muito_segura_de_no_minimo_32_caracteres_de_comprimento

# Chave de API da OpenAI
OPENAI_API_KEY=sk-sua-chave-openai-aqui

# Modelo da OpenAI utilizado para avaliação dos resumos (ex: gpt-4o-mini, gpt-4o, o3-mini)
OPENAI_MODEL=gpt-4o-mini

# Esforço de raciocínio (opcional, aplicável somente para modelos de raciocínio como o1, o3-mini ou gpt-5: low, medium, high)
# OPENAI_REASONING_EFFORT=low
